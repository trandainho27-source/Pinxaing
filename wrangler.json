{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinxiang-commerce",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinxiang-commerce-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "DEMO_MODE": "false"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "keep_vars": true,
  "unsafe": {
    "metadata": {
      "keep_bindings": [
        "plain_text",
        "json",
        "secret_text",
        "secret_key",
        "r2_bucket"
      ]
    }
  }
}
