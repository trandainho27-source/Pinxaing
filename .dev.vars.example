# Set your own values in Cloudflare Workers Settings / Variables and Secrets.
# INVENTORY_KEY: exactly 64 hexadecimal characters for Telegram gifts and historical encrypted data.
# Do not rotate this key after importing gift accounts without a data re-encryption plan.
INVENTORY_KEY=
# BOOTSTRAP_TOKEN: random one-time token for creating the first owner account.
BOOTSTRAP_TOKEN=
# WeChat, Alipay and USDT are reserved only; no payment secrets are required in this version.
# Real integrations must be implemented and verified later. See docs/PAYMENTS.md.

# Real customer email login and transactional order notifications. Never commit real API keys.
# Verify your sending domain with Resend before using EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=
# DEMO_MODE=true exposes a separate, labelled test-email flow. Keep false for real stores.
DEMO_MODE=false
